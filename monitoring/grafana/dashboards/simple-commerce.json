{
  "uid": "simple-commerce",
  "title": "Simple Commerce",
  "tags": [
    "simple-commerce",
    "opentelemetry"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
